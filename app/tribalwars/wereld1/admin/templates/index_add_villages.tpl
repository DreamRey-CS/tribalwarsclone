<h2>Bonus Köyleri Ekle</h2>
<form action="?screen=add_villages&amp;action=add_bonus" method="post">
<table class="vis"><tr><th colspan="3">Yeni bonus köyleri (en fazla 1000)</th></tr>{$error}<tr><td>Bonus türü</td><td><select name="bonus"><option value="0" selected="selected">Rastgele</option><option value="1">%50 daha fazla depo ve tüccar kapasitesi</option><option value="2">%10 daha fazla nüfus</option><option value="3">Ahırda %33 daha hızlı üretim</option><option value="4">Kışlada %33 daha hızlı üretim</option><option value="5">Atölyede %50 daha hızlı üretim</option><option value="6">%30 daha yüksek kaynak üretimi</option></select></td></tr><tr><td>Adet</td><td><input type="number" name="anzahl" min="1" max="1000" /></td><td><input type="submit" value="Köyleri Ekle" /></td></tr></table>
</form>
<div class="panel"><h3>Bonus Köyü İstatistikleri</h3><table><tr><th>Adet</th><th>Bonus</th></tr><tr><td>{$sate1}</td><td>%50 daha fazla depo ve tüccar kapasitesi</td></tr><tr><td>{$sate2}</td><td>%10 daha fazla nüfus</td></tr><tr><td>{$sate3}</td><td>Ahırda %33 daha hızlı üretim</td></tr><tr><td>{$sate4}</td><td>Kışlada %33 daha hızlı üretim</td></tr><tr><td>{$sate5}</td><td>Atölyede %50 daha hızlı üretim</td></tr><tr><td>{$sate6}</td><td>%30 daha yüksek kaynak üretimi</td></tr><tr><th>Toplam</th><th>{$total|format_number} bonus köyü</th></tr></table></div>
<h2>Barbar Köyleri Ekle</h2>
<form action="?screen=add_villages&amp;action=add_villages" method="post"><table class="vis"><tr><th colspan="3">Yeni barbar köyleri (en fazla 1000)</th></tr>{$err}<tr><td>Adet</td><td><input type="number" name="numar" min="1" max="1000" /></td><td><input name="buton" type="submit" value="Köyleri Ekle" /></td></tr><tr><td colspan="3">Mevcut barbar köyü sayısı: <strong>{$sate|format_number}</strong></td></tr></table></form>
